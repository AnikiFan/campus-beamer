  "themeCSS": "\ntext, tspan, .nodeLabel, .edgeLabel, .label, .messageText, .noteText {\n  font-family: CampusLatin, CampusCJK, sans-serif !important;\n  font-size: {{fontSize}}px !important;\n}\n.node rect, .node polygon, .node path, .node circle,\nrect.actor, rect.labelBox, rect.note, .cluster rect {\n  stroke-width: 1px !important;\n}\n.node rect, rect.actor { rx: 3px; ry: 3px; }\n.cluster rect { rx: 3px; ry: 3px; }\n.flowchart-link, .messageLine0, .messageLine1 { stroke-width: 1px !important; }\n.actor-line { stroke-width: .75px !important; }\n\ntext, tspan, foreignObject div, foreignObject span, foreignObject p {\n  font-family: CampusLatin, CampusCJK, sans-serif !important;\n  font-size: {{fontSize}}px !important;\n}\ntext, tspan { fill: #404040 !important; }\n.nodeLabel, .edgeLabel, .label { color: #404040 !important; }\n\n    .architecture-service svg rect, .architecture-groups svg rect { fill: {{color:100}} !important; }\n    .treeView-node-line { stroke: {{color:100}} !important; }\n    .treeView-node-icon { color: {{color:100}} !important; fill: {{color:100}} !important; }\n    .face { fill: {{color:7}} !important; stroke: {{color:100}} !important; }\n    .actor-0, .actor-1 { stroke: {{color:100}} !important; }\n    .nodes .node rect { fill: {{color:7}} !important; stroke: {{color:100}} !important; }\n    .participant-box, .occurrence, .frame-border-inner, .frame-border-outer {\n      fill: {{color:7}} !important; stroke: {{color:100}} !important;\n    }\n    .message-line, .lifeline, .frame-header-line { stroke: {{color:100}} !important; }\n    .arrow-head path { stroke: {{color:100}} !important; }\n    .packetBlock, .railroad-terminal rect, .railroad-nonterminal rect {\n      fill: {{color:7}} !important; stroke: {{color:100}} !important; stroke-width: 1px !important;\n    }\n    svg:has(> .node-labels) .nodes .node rect { fill: {{color:100}} !important; }\n    circle.actor-0 { fill: {{color:100}} !important; }\n    circle.actor-1 { fill: {{color:45}} !important; }\n    rect.task, rect.journey-section { stroke: {{color:100}} !important; }\n    .radarGraticule { fill: none !important; stroke: #cccccc !important; }\n    .radarCurve-0 { fill: {{color:100}} !important; fill-opacity: .12 !important; stroke: {{color:100}} !important; }\n    .radarCurve-1 { fill: {{color:65}} !important; fill-opacity: .1 !important;\n      stroke: {{color:65}} !important; stroke-dasharray: 5 3; }\n    .radarLegendBox-0 { fill: {{color:100}} !important; stroke: {{color:100}} !important; }\n    .radarLegendBox-1 { fill: {{color:65}} !important; stroke: {{color:65}} !important; }\n    svg[aria-roledescription=\"venn\"] path[style*=\"stroke-opacity\"] {\n      stroke: {{color:100}} !important; stroke-width: 1px !important;\n    }\n    svg[aria-roledescription=\"timeline\"] * { filter: none !important; }\n    ",
