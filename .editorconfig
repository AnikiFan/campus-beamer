root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cls,sty,tex,bib,cfg}]
indent_size = 2
indent_style = space

[*.{yml,yaml,json}]
indent_size = 2
indent_style = space

[*.{py,sh,toml}]
indent_size = 4
indent_style = space

[Dockerfile]
indent_size = 4
indent_style = space

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
