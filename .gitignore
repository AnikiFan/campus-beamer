# Local build output; retain source assets and curated docs/images previews.
/build/
!/build/
/build/*
.venv/
__pycache__/
*.py[cod]

# Local input materials and agent-authored presentation sources.
/materials/*
!/materials/.gitkeep
/main.tex
/outline.md
/theme/*/.installed-assets/
/sections/*
!/sections/.gitkeep
/bibliography/*
!/bibliography/.gitkeep

# TeX intermediates and generated slides, including nested examples.
*.aux
*.bbl
*.bcf
*.blg
*-blx.bib
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*-SAVE-ERROR
/*.pdf
/*.pptx

# Editor/OS temporary files.
*.swp
*.swo
.DS_Store
Thumbs.db
