\campus@autoframesubtitletrue

\newcommand{\campus@printreferences}[1]{%
  \ifstrequal{#1}{onecolumn}
    {\printbibliography[heading=none]}%
    {\ifstrequal{#1}{twocolumn}
      {\setlength{\columnsep}{1.5em}%
       \begin{multicols}{2}%
         \printbibliography[heading=none]%
       \end{multicols}}%
      {\PackageError{beamerthemecampus}
        {Unknown references page column mode '#1'}
        {Use onecolumn or twocolumn.}}}%
}

\newcommand{\campus@referencesframe}[3]{%
  \setbeamertemplate{frametitle}[campus page title]
  \begin{frame}[#1]{\campus@referencestitle}
    \renewcommand*{\bibfont}{\normalfont#2}%
    \vspace*{1pt}% 保证首次编译尚无 .bbl 时 shrink 仍有非零高度
    \campus@printreferences{#3}%
  \end{frame}%
}

\NewDocumentCommand{\referencespage}{O{shrink} O{\normalsize} O{onecolumn}}{%
  \@ifpackageloaded{biblatex}
    {%
      \begingroup
        \campus@autoframesubtitlefalse
        \ifstrequal{#1}{shrink}
          {\campus@referencesframe{shrink}{#2}{#3}}
          {%
            \ifstrequal{#1}{break}
              {\campus@referencesframe{allowframebreaks}{#2}{#3}}
              {\PackageError{beamerthemecampus}
                {Unknown references page mode '#1'}
                {Use shrink or break.}}%
          }%
      \endgroup
    }
    {%
      \PackageError{beamerthemecampus}
        {The references page requires biblatex}
        {Load biblatex and add a bibliography resource before using \string\referencespage.}%
    }%
}
