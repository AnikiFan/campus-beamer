% A normal frame with a vertically filled, right-aligned image panel.
% The image stops above the footer navigation and is masked away from the left content.
% Usage: \begin{rightimageframe}[image width=.40,page=2]{Title}{file.pdf}
\NewEnviron{rightimageframe}[3][]{%
  \begingroup
    \def\campus@rightimagewidthratio{0.40}%
    \def\campus@rightimagepage{}%
    \pgfkeys{/campus right image,#1}%
    \setlength{\campusrightimagewidth}{%
      \campus@rightimagewidthratio\paperwidth}%
    \setlength{\campusrightimageheight}{%
      \dimexpr\paperheight-\campusnavigationfooterheight-\campusfootlineheight-\campusfootlinedepth\relax}%
    \setlength{\campusrightimagecontentwidth}{%
      \dimexpr\textwidth-\campusrightimagewidth\relax}%
    \campuspartialheadline{\dimexpr\paperwidth-\campusrightimagewidth\relax}%
    \setbeamertemplate{background}{%
      \begin{tikzpicture}[remember picture,overlay]
        \node[
          anchor=north east,
          inner sep=0pt,
          outer sep=0pt
        ] at (current page.north east) {\campus@rightimagegraphic{#3}};
        \usebeamercolor[bg]{normal text}
        \fill (current page.north west)
          rectangle ([xshift=-\campusrightimagewidth]current page.south east);
      \end{tikzpicture}%
    }%
    \frame{%
      \frametitle{#2}%
      \begin{minipage}{\campusrightimagecontentwidth}
        \BODY
      \end{minipage}%
    }%
  \endgroup
}
