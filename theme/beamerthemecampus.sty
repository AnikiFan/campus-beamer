% Keep each cover metadata row on exactly one baseline of its active font.
% Using fixed-height boxes avoids paragraph glue or font-transition effects
% changing the distance between adjacent rows.
\newcommand{\campus@coverline}[2]{%
  \begingroup
    \usebeamerfont{#1}%
    \nointerlineskip
    \edef\campus@coverlinebaseline{\the\baselineskip}%
    \vbox to \baselineskip{%
      \vfil\hbox{\strut#2%
        \ifcampus@layoutguides
          \rlap{\hspace{2mm}\color{red}\tiny\ttfamily
            [\ifstrequal{#1}{subtitle}{\string\Large}{\string\normalsize};\space
            \campus@coverlinebaseline]}%
        \fi
      }\vfil
    }%
  \endgroup
}
