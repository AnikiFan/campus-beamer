\pgfkeys{
  /campus layout/.is family,
  /campus layout,
  template language/.is choice,
  template language/chinese/.code = \campus@setchineselanguage,
  template language/english/.code = \campus@setenglishlanguage,
  corner width/.code = \setcornercitewidth{#1},
  section navigation/.is choice,
  section navigation/on/.code = \campus@sectionnavigationenabledtrue,
  section navigation/off/.code = \campus@sectionnavigationenabledfalse,
  % Compatibility with the earlier progress-indicator switch.
  section progress/.is choice,
  section progress/on/.code  = \campus@sectionnavigationenabledtrue,
  section progress/off/.code = \campus@sectionnavigationenabledfalse,
  section progress width/.code = {}, % Deprecated: retained for older configs.
}
\newcommand{\campussetlayout}[1]{%
  \pgfkeys{/campus layout,#1}%
  \campus@updatenavigationfooterheight}

% Fit an image or one PDF page into a page-relative box without distortion.
% The width and height keys are unitless fractions of the slide dimensions.
\pgfkeys{
  /campus fit graphic/.is family,
  /campus fit graphic,
  width/.store in = \campus@fitgraphicwidthratio,
  height/.store in = \campus@fitgraphicheightratio,
  page/.store in = \campus@fitgraphicpage,
}

\newcommand{\fitgraphic}[2][]{%
  \begingroup
    \def\campus@fitgraphicwidthratio{0.85}%
    \def\campus@fitgraphicheightratio{0.60}%
    \def\campus@fitgraphicpage{}%
    \pgfkeys{/campus fit graphic,#1}%
    \setlength{\campusfitgraphicwidth}{%
      \campus@fitgraphicwidthratio\paperwidth}%
    \setlength{\campusfitgraphicheight}{%
      \campus@fitgraphicheightratio\paperheight}%
    \makebox[\linewidth][c]{%
      \begin{minipage}[c][\campusfitgraphicheight][c]{\campusfitgraphicwidth}
        \centering
        \ifdefempty{\campus@fitgraphicpage}
          {\includegraphics[
              width=\campusfitgraphicwidth,
              height=\campusfitgraphicheight,
              keepaspectratio
            ]{#2}}
          {\includegraphics[
              page=\campus@fitgraphicpage,
              width=\campusfitgraphicwidth,
              height=\campusfitgraphicheight,
              keepaspectratio
            ]{#2}}%
      \end{minipage}%
    }%
  \endgroup
}

% A compact figure wrapper for the common graphic-plus-caption pattern.
% Pass an empty third argument when no caption is needed.
\newcommand{\fitfigure}[3][]{%
  \begin{figure}
    \centering
    \fitgraphic[#1]{#2}
    \ifstrempty{#3}{}{\caption{#3}}%
  \end{figure}
}

\newcommand{\@footlineauthor}{\insertauthor \enspace$\vert$\enspace}
\newcommand{\@footlinepayoff}{\@footlineauthor\inserttitle}
\newcommand{\footlinepayoff}[1]{\renewcommand{\@footlinepayoff}{#1}}
% Align the midpoint of the actual text box with the midpoint of the band.
% No struts: their invisible padding would change the measured text bounds.
% The band's bounds relative to its baseline are [-depth, height].
% Band dimensions come from the baseline grid; the remaining correction is
% measured from the glyph box, so no fixed optical offset is needed.
\newcommand{\campus@centerfootertext}[3]{%
  \sbox{\campus@footertext}{#3}%
  \setlength{\campusfootlinetextraise}{%
    \dimexpr(#1-#2-\ht\campus@footertext+\dp\campus@footertext)/2+\campusfootlinenudge\relax}%
  \raisebox{\campusfootlinetextraise}[0pt][0pt]{\usebox{\campus@footertext}}%
}
% The standard horizontal navigation macros use flexible glue that can make
% the entries visually bunch together.  Give every entry an equal-width cell
% instead, while retaining Beamer's normal section/subsection hyperlinks.
\newcommand{\campus@sectionnavigation}{%
  \ifnum\beamer@sectionmax>0\relax
    \setlength{\campus@sectioncellwidth}{\dimexpr\paperwidth/\beamer@sectionmax\relax}%
    \hbox to \paperwidth{{%
      \def\slideentry##1##2##3##4##5##6{}%
      \def\sectionentry##1##2##3##4##5{%
        \ifnum##5=\c@part
          \def\insertsectionhead{##2}%
          \def\insertsectionheadnumber{##1}%
          \def\insertpartheadnumber{##5}%
          \hyperlink{Navigation##3}{%
            \hbox to \campus@sectioncellwidth{%
              \hfil
              \ifnum\c@section=##1
                \usebeamertemplate{section in head/foot}%
              \else
                \usebeamertemplate{section in head/foot shaded}%
              \fi
              \hfil}}%
        \fi}%
      \dohead
    }}%
  \fi
}

\newcommand{\campus@subsectionnavigation}{%
  \campus@subsectioncount=0\relax
  \def\sectionentry##1##2##3##4##5{}%
  \def\slideentry##1##2##3##4##5##6{%
    \ifnum##6=\c@part\ifnum##1=\c@section
      \ifnum##2>\campus@subsectioncount
        \campus@subsectioncount=##2\relax
      \fi
    \fi\fi}%
  \dohead
  \ifnum\campus@subsectioncount>0\relax
    \setlength{\campus@subsectioncellwidth}{\dimexpr\paperwidth/\campus@subsectioncount\relax}%
    \hbox to \paperwidth{{%
      \def\sectionentry##1##2##3##4##5{}%
      \beamer@currentsubsection=0\relax
      \def\slideentry##1##2##3##4##5##6{%
        \ifnum##6=\c@part\ifnum##1=\c@section
          \ifnum##2>\beamer@currentsubsection
            \beamer@currentsubsection=##2\relax
            \def\insertsubsectionhead{##5}%
            \def\insertsectionheadnumber{##1}%
            \def\insertsubsectionheadnumber{##2}%
            \def\insertpartheadnumber{##6}%
            \beamer@link(##4){%
              \hbox to \campus@subsectioncellwidth{%
                \hfil
                \ifnum\c@subsection=##2
                  \usebeamertemplate{subsection in head/foot}%
                \else
                  \usebeamertemplate{subsection in head/foot shaded}%
                \fi
                \hfil}}%
          \fi
        \fi\fi}%
      \dohead
    }}%
  \fi
}

% Define footline content
\newcommand{\campus@footnavigation}{%
  \ifcampus@sectionnavigationenabled
    % Subsections sit above sections; the lower section row uses the darker tint.
    \begin{beamercolorbox}[wd=\paperwidth,ht=\campussubsectionnavigationheight,dp=\campusfootlinedepth,vmode]{navigation footer subsection}%
      \campus@centerfootertext{\campussubsectionnavigationheight}{\campusfootlinedepth}{%
        \usebeamerfont{subsection in head/foot}\usebeamercolor[fg]{subsection in head/foot}%
        \campus@subsectionnavigation}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=\paperwidth,ht=\campussectionnavigationheight,dp=\campusfootlinedepth,vmode]{navigation footer section}%
      \campus@centerfootertext{\campussectionnavigationheight}{\campusfootlinedepth}{%
        \usebeamerfont{section in head/foot}\usebeamercolor[fg]{section in head/foot}%
        \campus@sectionnavigation}%
    \end{beamercolorbox}%
  \fi
}

\setbeamertemplate{footline}{%
  \campus@footnavigation
  \begin{beamercolorbox}[wd=\textwidth,ht=\campusfootlineheight,dp=\campusfootlinedepth,vmode]{footline}
  \campus@centerfootertext{\campusfootlineheight}{\campusfootlinedepth}{%
    \hbox to \textwidth{%
      \hspace*{\campuslogoleftskip}%
      \hbox to \dimexpr\textwidth-2\campuslogoleftskip\relax{%
        \usebeamerfont{footline}\insertframenumber/\inserttotalframenumber
        \ifstrempty{\@footlinepayoff}{}{%
          \hfill\@footlinepayoff
        }%
      }%
      \hspace*{\campuslogoleftskip}%
    }%
  }%
  \end{beamercolorbox}
}

