% Collect every subsection belonging to the current section.  The information
% is read from Beamer's TOC file, so the command can appear immediately after
% \section and latexmk will refresh it on the normal multi-pass build.
\newcommand{\campus@collectsectionsubsections}{%
  \campus@tocsubsectioncount=0\relax
  \def\beamer@sectionintoc##1##2##3##4##5{}%
  \def\beamer@subsubsectionintoc##1##2##3##4##5##6##7{}%
  \def\beamer@subsectionintoc##1##2##3##4##5##6{%
    \ifnum##1=\c@section\relax
      \ifnum##5=\c@part\relax
        \advance\campus@tocsubsectioncount by 1\relax
        \edef\campus@entryindex{\the\campus@tocsubsectioncount}%
        \expandafter\def\csname campus@subsectiontitle@\campus@entryindex\endcsname{##3}%
        \expandafter\def\csname campus@subsectionnumber@\campus@entryindex\endcsname{##2}%
        \expandafter\def\csname campus@subsectionlink@\campus@entryindex\endcsname{##4}%
      \fi
    \fi
  }%
  \catcode`\@=11\relax
  \InputIfFileExists{\jobname.toc}{}{}%
  \catcode`\@=12\relax
}

\newcommand{\campus@rendersectionsubsection}[1]{%
  \usebeamerfont{section page subtitle}\usebeamercolor[fg]{section page subtitle}%
  \raggedright
  % Reserve one common number column.  This keeps 4.1, 4.2, ... anchored at
  % the same title position in both the single- and two-column layouts.
  \hangindent=\campus@subsectionnumberwidth\hangafter=1\relax
  \noindent\strut
  \hyperlink{Navigation\csname campus@subsectionlink@#1\endcsname}{%
    \makebox[\campus@subsectionnumberwidth][l]{%
      \thesection.\csname campus@subsectionnumber@#1\endcsname\enspace}%
    \csname campus@subsectiontitle@#1\endcsname}%
  % Keep the final strut on the last text line, never on a phantom blank line.
  \unskip\nobreak\strut\par
}

% Four or more entries use pairs of top-aligned cells in row-major order.
% Stack row boxes directly with a fixed gap, without paragraph baseline glue.
% An absent right entry contributes no box or baseline to the last row.
\newcommand{\campus@rendersectionsubsectionrow}[2]{%
  \par\nointerlineskip\hbox to \linewidth{%
    \begin{minipage}[t]{0.47\linewidth}%
      \campus@rendersectionsubsection{#1}%
    \end{minipage}%
    \hfil
    \ifnum#2>\campus@tocsubsectioncount\relax
    \else
      \begin{minipage}[t]{0.47\linewidth}%
        \campus@rendersectionsubsection{#2}%
      \end{minipage}%
    \fi
  }%
  % The cell's own baseline is the row spacing.  Do not add a second
  % inter-row skip here: that would make the two-column list looser than the
  % single-column list.
}

\newcommand{\campus@rendersectionrows}[1]{%
  \ifnum#1>\campus@tocsubsectioncount\relax
  \else
    \edef\campus@nextsubsection{\number\numexpr#1+1\relax}%
    {\campus@rendersectionsubsection{#1}}%
    \expandafter\campus@rendersectionrows\expandafter{\campus@nextsubsection}%
  \fi
}

\newcommand{\campus@rendersectiontwocolumnrows}[1]{%
  \ifnum#1>\campus@tocsubsectioncount\relax
  \else
    \edef\campus@nextsubsection{\number\numexpr#1+2\relax}%
    \edef\campus@rightsubsection{\number\numexpr#1+1\relax}%
    \campus@rendersectionsubsectionrow{#1}{\campus@rightsubsection}%
    \expandafter\campus@rendersectiontwocolumnrows\expandafter{\campus@nextsubsection}%
  \fi
}

\newcommand{\campus@measuresectionsubsectionnumber}[1]{%
  \ifnum#1>\campus@tocsubsectioncount\relax
  \else
    \settowidth{\@tempdima}{\thesection.\csname campus@subsectionnumber@#1\endcsname\enspace}%
    \ifdim\@tempdima>\campus@subsectionnumberwidth
      \setlength{\campus@subsectionnumberwidth}{\@tempdima}%
    \fi
    \edef\campus@nextnumber{\number\numexpr#1+1\relax}%
    \expandafter\campus@measuresectionsubsectionnumber\expandafter{\campus@nextnumber}%
  \fi
}

\newcommand{\campussectionsubsectiontoc}{%
  \par\begingroup
  \setlength{\parskip}{0pt}%
  \campus@collectsectionsubsections
  % Measure the actual numbers in this section so the title column has no
  % unnecessary two-digit reservation when only 1--9 subsections are present.
  \setlength{\campus@subsectionnumberwidth}{0pt}%
  \campus@measuresectionsubsectionnumber{1}%
  \ifnum\campus@tocsubsectioncount<4\relax
    \campus@rendersectionrows{1}%
  \else
    \campus@rendersectiontwocolumnrows{1}%
  \fi
  \endgroup
}

% Generate a section opening slide on demand.  The section title and number are
% read from the current \section.  The subsection list is loaded from the TOC;
% The optional background accepts an image path, white, or primary (purple is a legacy alias).
% Usage: \sectioncoverpage[image|white|primary]{introductory text}[image options]
% An omitted (or empty) background retains the original solid primary-color default.
% (The name deliberately avoids Beamer's built-in \sectionpage command.)
\NewDocumentCommand{\sectioncoverpage}{O{} +m O{}}{%
  \begingroup
  % Expand profile-provided backgrounds before testing the built-in modes.
  \edef\campus@sectionbackground{#1}%
  % The vertical gaps on a section page follow the active fonts rather than
  % fixed millimetre values: the label-to-title gap uses the label baseline;
  % the title-to-list and list-to-intro gaps use the subsection baseline.
  \usebeamerfont{section page label}%
  \setlength{\campussectionpagelabelbaseline}{\baselineskip}%
  \usebeamerfont{section page subtitle}%
  \setlength{\campussectionpagesubsectionbaseline}{\baselineskip}%
  \themecolor{main}
  \setbeamertemplate{footline}{}
  \setbeamertemplate{frametitle}{}
  \campuspartialheadline{0.56\paperwidth}
  \setbeamercolor{normal text}{fg=white,bg=maincolor}
  \setbeamertemplate{background}{}
  \ifdefstring{\campus@sectionbackground}{white}{%
    \setbeamertemplate{background}{\TikzWhiteRightSplit}
  }{%
    \ifboolexpr{ test {\ifdefstring{\campus@sectionbackground}{primary}} or test {\ifdefstring{\campus@sectionbackground}{purple}} }{}{%
      \ifdefempty{\campus@sectionbackground}{}{%
        \setbeamertemplate{background}{\TikzSplitSlide[#3]{\campus@sectionbackground}}}%
    }%
  }
  \frame[t]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=west,inner sep=0pt,outer sep=0pt] (section-title)
      at ([xshift=\campuslogoleftskip]current page.west) {%
      \begin{minipage}{0.50\textwidth}
        \raggedright\usebeamerfont{section page title}%
        \usebeamercolor[fg]{section page title}\secname\par
      \end{minipage}%
    };
    \node[anchor=south west,inner sep=0pt,outer sep=0pt,
      yshift=\campussectionpagelabelbaseline] (section-label) at (section-title.north west) {%
      \usebeamerfont{section page label}\usebeamercolor[fg]{section page label}%
      \campus@sectionlabel{\thesection}%
    };
    \node[anchor=north west,inner sep=0pt,outer sep=0pt,
      yshift=-\campussectionpagesubsectionbaseline] (section-body) at (section-title.south west) {%
      \begin{minipage}{0.50\textwidth}
        \raggedright
        \ifcampus@layoutguides
          % Unbox the measured list so diagnostics add no spacing or wrapping.
          \setbox\campus@guidesectionlist=\vbox{\campussectionsubsectiontoc}%
          \global\campus@guidesectionlistheight=\dimexpr
            \ht\campus@guidesectionlist+\dp\campus@guidesectionlist\relax
          \unvbox\campus@guidesectionlist
        \else
          \campussectionsubsectiontoc
        \fi
        \par\nointerlineskip
        \vskip\campussectionpagesubsectionbaseline
        {\usebeamerfont{section page body}\usebeamercolor[fg]{section page body}%
          \addtolength{\hsize}{2em}%
          \setlength{\linewidth}{\hsize}%
          #2\par}%
      \end{minipage}%
    };
    \ifcampus@layoutguides
      \draw[red,line width=.5pt] (section-label.north west) rectangle (section-label.south east);
      \node[anchor=south west,draw=red,fill=white,text=red,inner sep=1pt,font=\tiny]
        at (section-label.north west)
        {\campus@guidefontlabel{section page label}{章节编号}{\string\Large}};
      \draw[red,line width=.5pt] (section-title.north west) rectangle (section-title.south east);
      \node[anchor=west,draw=red,fill=white,text=red,inner sep=1pt,font=\tiny]
        at (section-title.east)
        {\campus@guidefontlabel{section page title}{章节标题}{\string\Huge}};
      \draw[red,line width=.5pt] (section-body.north west) rectangle (section-body.south east);
      \node[anchor=north west,draw=red,fill=white,text=red,inner sep=1pt,font=\tiny]
        at (section-body.south west)
        {\campus@guidefontlabel{section page body}{小节列表/导读}{\string\normalsize}};
      \draw[red,dashed] ([xshift=\campuslogoleftskip]current page.north west)
        -- ([xshift=\campuslogoleftskip]current page.south west);
      \draw[red,dashed] (current page.west) -- (current page.east);
      \coordinate (section-gap-x) at ([xshift=2mm]section-title.east);
      \coordinate (section-page-top) at (section-gap-x |- current page.north);
      \coordinate (section-label-top) at (section-gap-x |- section-label.north);
      \coordinate (section-label-bottom) at (section-gap-x |- section-label.south);
      \coordinate (section-title-top) at (section-gap-x |- section-title.north);
      \coordinate (section-title-bottom) at (section-gap-x |- section-title.south);
      \coordinate (section-list-top) at (section-gap-x |- section-body.north);
      \coordinate (section-list-bottom) at
        ([yshift=-\campus@guidesectionlistheight]section-list-top);
      \coordinate (section-intro-top) at
        ([yshift=-\campussectionpagesubsectionbaseline]section-list-bottom);
      \coordinate (section-body-bottom) at (section-gap-x |- section-body.south);
      \coordinate (section-page-bottom) at (section-gap-x |- current page.south);
      \draw[red,dotted] (section-body.west |- section-list-bottom)
        -- (section-body.east |- section-list-bottom);
      \draw[red,dotted] (section-body.west |- section-intro-top)
        -- (section-body.east |- section-intro-top);
      \campus@guideverticalgap{section-page-top}{section-label-top}
        {\campussectionpagelabelbaseline}{\string\Large}{页顶→编号}
      \campus@guideverticalgap{section-label-bottom}{section-title-top}
        {\campussectionpagelabelbaseline}{\string\Large}{编号→标题}
      \campus@guideverticalgap{section-title-bottom}{section-list-top}
        {\campussectionpagesubsectionbaseline}{\string\normalsize}{标题→列表}
      \campus@guideverticalgap{section-list-bottom}{section-intro-top}
        {\campussectionpagesubsectionbaseline}{\string\normalsize}{列表→导读}
      \campus@guideverticalgap{section-body-bottom}{section-page-bottom}
        {\campussectionpagesubsectionbaseline}{\string\normalsize}{导读→页底}
    \fi
  \end{tikzpicture}%
  }%
  \endgroup
}

% Generate the all-section overview slide on demand.  Keeping this as a
% command means authors can place it before or after a section opening slide,
% or omit it for sections where it is not useful.
\newcommand{\sectiontocpage}{%
  \begingroup
  \themecolor{main}
  \setbeamertemplate{footline}{}
  \setbeamertemplate{frametitle}[campus page title]
  \begin{frame}{\campus@tableofcontentstitle}
    \tableofcontents[currentsection,hideallsubsections]
  \end{frame}
  \endgroup
}
