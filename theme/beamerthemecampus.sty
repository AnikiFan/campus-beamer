% Shared diagonal geometry for cover panels, photographs and white section panels.
% Angle is measured from horizontal-right towards the line's upper-right end.
\newcommand{\campussplitmidfraction}{0.618}
\newcommand{\campussplitangle}{72}
\newcommand{\campus@splitcoordinates}{%
  \pgfmathsetlength{\campussplitmidpoint}{\campussplitmidfraction*\paperwidth}%
  \pgfmathsetlength{\campussplithalfshift}{.5*\paperheight/tan(\campussplitangle)}%
  \setlength{\campussplittop}{\dimexpr\campussplitmidpoint+\campussplithalfshift\relax}%
  \setlength{\campussplitbottom}{\dimexpr\campussplitmidpoint-\campussplithalfshift\relax}%
  \coordinate (split-top) at ([xshift=\campussplittop]current page.north west);
  \coordinate (split-bottom) at ([xshift=\campussplitbottom]current page.south west);
  \coordinate (split-mid) at ([xshift=\campussplitmidpoint]current page.west);
}
\newcommand{\campus@splitpath}{%
  (split-top) -- (current page.north east) --
  (current page.south east) -- (split-bottom) -- cycle%
}
\newcommand{\campus@guidesplit}{%
  \ifcampus@layoutguides
    \draw[red,line width=.5pt] (split-top) -- (split-bottom);
    \draw[red,dashed] (split-mid |- current page.north) -- (split-mid |- current page.south);
    \fill[red] (split-mid) circle[radius=1pt];
    \node[anchor=south west,fill=white,text=red,font=\tiny,inner sep=.5pt]
      at (split-mid) {中点：\pgfmathparse{100*\campussplitmidfraction}%
        \pgfmathprintnumber[fixed,precision=1]{\pgfmathresult}\% 页面宽度};
    \draw[red,dashed] (split-mid) -- ([xshift=8mm]split-mid);
    \draw[red,->] ([xshift=8mm]split-mid)
      arc[start angle=0,end angle=\campussplitangle,radius=8mm];
    \node[anchor=west,fill=white,text=red,font=\tiny,inner sep=.5pt]
      at ([xshift=8mm,yshift=6mm]split-mid) {$\campussplitangle^\circ$（与水平线）};
  \fi
}
\pgfkeys{
  /campus split image/.is family,
  /campus split image,
  trim right/.store in=\campus@splittrimfraction,
  align/.is choice,
  align/right/.code={\def\campus@splitimagealign{right}},
  align/center/.code={\def\campus@splitimagealign{center}},
}
\newcommand{\TikzSplitSlide}[2][]{%
  \begin{tikzpicture}[remember picture,overlay]
    \pgfkeys{/campus split image/.cd,trim right=0,align=right,#1}%
    \campus@splitcoordinates
    \begin{scope}
      \clip \campus@splitpath;
      % Measure trimming against the original image width, before scaling.
      \sbox{\campus@splitimage}{\includegraphics{#2}}%
      \pgfmathsetlengthmacro{\campus@splittrimright}{%
        \campus@splittrimfraction*\wd\campus@splitimage}%
      % Cover the entire panel without distorting even a portrait photograph.
      % Expand the dimensions before graphicx parses the space-delimited trim.
      \edef\campus@splitgraphicoptions{%
        trim=0 0 \campus@splittrimright\space 0,clip,height=\the\paperheight}%
      \sbox{\campus@splitimage}{%
        \expandafter\includegraphics\expandafter[\campus@splitgraphicoptions]{#2}}%
      \ifdim\wd\campus@splitimage<\dimexpr\paperwidth-\campussplitbottom\relax
        \edef\campus@splitgraphicoptions{%
          trim=0 0 \campus@splittrimright\space 0,clip,
          width=\the\dimexpr\paperwidth-\campussplitbottom\relax}%
        \sbox{\campus@splitimage}{%
          \expandafter\includegraphics\expandafter[\campus@splitgraphicoptions]{#2}}%
      \fi
      % Alignment is computed only after the final proportional scaling.
      % Use the measured final width: left + scaled width = page width.
      \ifdefstring{\campus@splitimagealign}{center}{%
        \setlength{\campussplitimageleft}{%
          \dimexpr.5\paperwidth+.5\campussplitbottom-.5\wd\campus@splitimage\relax}%
      }{%
        \setlength{\campussplitimageleft}{%
          \dimexpr\paperwidth-\wd\campus@splitimage\relax}%
      }%
      \node[anchor=west,inner sep=0pt,outer sep=0pt]
        at ([xshift=\campussplitimageleft]current page.west)
        {\usebox{\campus@splitimage}};
    \end{scope}
    \campus@guidesplit
  \end{tikzpicture}%
}

% Section-cover variant with the same diagonal boundary as the image split,
% but a plain white panel on the right and the primary color retained on left.
\newcommand{\TikzWhiteRightSplit}{%
  \begin{tikzpicture}[remember picture,overlay]
    \campus@splitcoordinates
    \fill[white] \campus@splitpath;
    \campus@guidesplit
  \end{tikzpicture}%
}

% The cover has one fixed primary-color split panel and transparent wordmark.
% Panel and wordmark geometry remain independent.
\newcommand{\campus@titlebackground}{%
  \pgfmathsetlength{\campuswordmarkleftskip}{\campussplitmidfraction*\paperwidth}%
  \setlength{\campuswordmarkwidth}{%
    \dimexpr\paperwidth-\campuswordmarkleftskip-\campuswordmarkrightskip\relax}%
  \begin{tikzpicture}[remember picture,overlay]
    \campus@splitcoordinates
    \fill[maincolor] \campus@splitpath;
    \campus@guidesplit
    \node[anchor=south east,inner sep=0pt,outer sep=0pt] (cover-wordmark)
      at ([xshift=-\campuswordmarkrightskip,
        yshift=\campuswordmarkbottomskip]current page.south east) {%
      \includegraphics[width=\campuswordmarkwidth]{\schoolwordmarkondark}%
    };
    \ifcampus@layoutguides
      \pgfextracty{\campuswordmarkheight}{\pgfpointdiff
        {\pgfpointanchor{cover-wordmark}{south}}{\pgfpointanchor{cover-wordmark}{north}}}%
      \draw[red,dashed] (cover-wordmark.west |- current page.north) --
        (cover-wordmark.west |- current page.south);
      \draw[red,line width=.5pt]
        (cover-wordmark.north west) rectangle (cover-wordmark.south east);
      \draw[red,<->] (cover-wordmark.east) -- (current page.east |- cover-wordmark.east);
      \draw[red,<->] (cover-wordmark.south) -- (current page.south -| cover-wordmark.south);
      \node[anchor=north east,align=right,fill=white,text=red,font=\tiny,inner sep=.5pt]
        at (cover-wordmark.south east)
        {等比缩放：宽度 \the\campuswordmarkwidth，高度 \the\campuswordmarkheight\\
         左边缘：\pgfmathparse{100*\campussplitmidfraction}%
         \pgfmathprintnumber[fixed,precision=1]{\pgfmathresult}\% 页面宽度；%
         右/下边距：1 \texttt{baselineskip} (\texttt{\string\large}) = \the\campuswordmarkrightskip};
    \fi
  \end{tikzpicture}%
}
% Keep the former starred primary spelling as an alias, not a layout switch.
\NewDocumentCommand{\titlebackground}{s m}{%
