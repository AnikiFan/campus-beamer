\newcommand{\campus@cornerciteprinter}{\campus@printcornercite}
\newcommand{\campus@printcornercite}[1]{%
  \begingroup
    \edef\campus@citationkey{\zap@space#1 \@empty}%
    \ifcsdef{campus@cornerciteformat}
      {\expandafter\campus@cornerciteformat\expandafter{\campus@citationkey}}
      {\texttt{\campus@citationkey}}%
    \par
  \endgroup
}

\newcommand{\campus@placecornercite}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[
      anchor=#1,
      xshift=#3,
      yshift=#4,
      inner sep=0pt,
    ] at (#2) {{%
      \usebeamerfont{slide citation}%
      \usebeamercolor[fg]{slide citation}%
      \parbox{\campuscornerwidth}{%
        \raggedright
        \setlength{\parskip}{0pt}%
        \setlength{\lineskip}{0pt}%
        \forcsvlist{\campus@cornerciteprinter}{#5}%
      }%
    }};
  \end{tikzpicture}%
}

% Local assignment: when used inside a frame, its group restores the default
% on exit. Put this before citations (or in the body of a paperframe).
\newcommand{\setcornercitewidth}[1]{%
  \setlength{\campuscornerwidth}{#1}%
}

\newcommand{\cornercite}[2][top-right]{%
  \begingroup
    \setlength{\@tempdima}{%
      \dimexpr\campusnavigationfooterheight+\campusfootlineheight+\campusfootlinedepth+\campuscornerymargin\relax
    }%
    \ifstrequal{#1}{top-right}
      {\campus@placecornercite
        {north east}{current page.north east}
        {-\campuscornerxmargin}{-\campuscornertopmargin}{#2}}
      {%
        \ifstrequal{#1}{bottom-left}
          {\campus@placecornercite
            {south west}{current page.south west}
            {\campuscornerxmargin}{\@tempdima}{#2}}
          {%
            \ifstrequal{#1}{bottom-right}
              {\campus@placecornercite
                {south east}{current page.south east}
                {-\campuscornerxmargin}{\@tempdima}{#2}}
              {\PackageError{beamerthemecampus}
                {Unknown corner citation position '#1'}
                {Use top-right, bottom-left, or bottom-right.}}%
          }%
      }%
  \endgroup
}

% A paper-focused frame with an optional stage subtitle and automatic citation.
% Usage: \begin{paperframe}[Method]{Paper title}{key1,key2}[bottom-left][6cm]
% The trailing position defaults to top-right and the width to the global
% corner-citation width; the legacy subtitle is retained.
\NewDocumentEnvironment{paperframe}{O{} m m O{top-right} O{} +b}{%
  \frame{%
    \frametitle{#2}%
    \ifstrempty{#1}{}{\framesubtitle{#1}}%
    \ifstrempty{#5}{}{\setcornercitewidth{#5}}%
    #6%
    \ifstrempty{#3}{}{%
      \begingroup
        \let\campus@cornerciteprinter\campus@printpaperframecite
        \cornercite[#4]{#3}%
      \endgroup
    }%
  }%
}{}

% Keep legacy slide-only `shorthand` values away from biblatex's bibliography
% labels.  `usera` is a standard, otherwise unused biblatex data field.
\AtEndPreamble{%
  \@ifpackageloaded{biblatex}{%
    \DeclareSourcemap{%
      \maps[datatype=bibtex]{%
        \map{%
          \step[fieldsource=shorthand,fieldtarget=usera]%
          \step[fieldset=shorthand,null]%
        }%
      }%
    }%
  }{}%
}

\AtBeginDocument{%
  \@ifpackageloaded{biblatex}{%
    \DeclareCiteCommand{\campus@cornerciteformat}
      {}
      {%
        \iffieldundef{usera}{%
          \ifnameundef{author}
            {%
              \iffieldundef{title}
                {\printfield{shorttitle}}
                {\printfield{title}}%
              \iffieldundef{year}
                {}
                {\setunit{\addcomma\space}\printfield{year}}%
            }
            {%
              \printnames{author}%
              \iffieldundef{year}
                {}
                {\setunit{\addcomma\space}\printfield{year}}%
              \iffieldundef{title}
                {%
                  \iffieldundef{shorttitle}
                    {}
                    {\setunit{\addcomma\space}\printfield{shorttitle}}%
                }
                {\setunit{\addcomma\space}\printfield{title}}%
            }%
        }{%
          \printfield{usera}%
          \iffieldundef{title}
            {%
              \iffieldundef{shorttitle}
                {}
                {\setunit{\addcomma\space}\printfield{shorttitle}}%
            }
            {\setunit{\addcomma\space}\printfield{title}}%
        }%
      }
      {\addsemicolon\space}
      {}
    % Paper frames reuse the same compact citation typography, then append
    % optional metadata fields in the same paragraph.
    \DeclareCiteCommand{\campus@paperframeciteformat}
      {}
      {%
        \campus@cornerciteformat{\thefield{entrykey}}%
        \iffieldundef{userb}{}{\enspace\textbar\enspace\campus@paperinstitutionlabel\campus@authorlabelcolon\space\printfield{userb}}%
        \iffieldundef{userc}{}{\enspace\textbar\enspace\campus@papervenuelabel\campus@authorlabelcolon\space\printfield{userc}}%
        \iffieldundef{usere}{%
        }{%
          \enspace\textbar\enspace\campus@papercitationslabel\campus@authorlabelcolon\space\printfield{usere}%
          \iffieldundef{userf}{}{\space\campus@paperdateopen\printfield{userf}\campus@paperdateclose}%
        }%
      }
      {}
      {}
  }{}
}

\newcommand{\campus@printpaperframecite}[1]{%
  \begingroup
    \edef\campus@citationkey{\zap@space#1 \@empty}%
    \ifcsdef{campus@paperframeciteformat}
      {\expandafter\campus@paperframeciteformat\expandafter{\campus@citationkey}}
      {\campus@printcornercite{\campus@citationkey}}%
    \par
  \endgroup
}

