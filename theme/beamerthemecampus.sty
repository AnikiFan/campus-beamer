% Measure the date row's invisible bottom padding. The closing message uses
% its actual text bounds, so its bottom can meet the date's text bottom even
% though the two blocks use different font sizes.
\newcommand{\campus@prepareclosingmessage}{%
  \usebeamerfont{date}%
  % Ink bounds matter here: Latin descenders (e.g. in "Any questions?")
  % differ from the font-wide height/depth used for ordinary line spacing.
  % Keep the metadata row/strut unchanged, measuring only its visible date.
  \sbox{\campus@closingdate}{{\XeTeXuseglyphmetrics=1 \insertdate}}%
  \sbox{\campus@closingdatestrut}{\strut\insertdate}%
  \setlength{\campus@closingdatepadding}{%
    \dimexpr(\baselineskip-\ht\campus@closingdatestrut
      -\dp\campus@closingdatestrut)/2
      +\dp\campus@closingdatestrut-\dp\campus@closingdate\relax}%
  \usebeamerfont{closing message}\usebeamercolor[fg]{normal text}%
  \setlength{\campus@closingmessagebaseline}{\baselineskip}%
  \sbox{\campus@closingfirst}{{\XeTeXuseglyphmetrics=1 \campus@thankyoufirst}}%
  \sbox{\campus@closingsecond}{{\XeTeXuseglyphmetrics=1 \campus@thankyousecond}}%
  \setlength{\campus@closingmessagewidth}{\wd\campus@closingfirst}%
  \ifdim\wd\campus@closingsecond>\campus@closingmessagewidth
    \setlength{\campus@closingmessagewidth}{\wd\campus@closingsecond}%
  \fi
  \setbox\campus@closingmessage=\vbox{%
    \offinterlineskip
    \hbox to \campus@closingmessagewidth{\hfil\usebox{\campus@closingfirst}}%
    \kern\dimexpr\campus@closingmessagebaseline-\dp\campus@closingfirst
      -\ht\campus@closingsecond\relax
    \hbox to \campus@closingmessagewidth{\hfil\usebox{\campus@closingsecond}}%
  }%
}

\newcommand{\backmatter}[1][]{
\begingroup
  \themecolor{main}
  \setbeamercolor{normal text}{fg=white,bg=maincolor}
  \setbeamercolor{author}{fg=white}
  \setbeamercolor{date}{fg=white}
  \begin{frame}[plain,c]
    \campus@prepareclosingmessage
    % Keep the closing title on the same vertical centre as the cover title.
    % The metadata and closing message hang below that independent title
    % anchor, so changing metadata cannot move the title.
    \begin{tikzpicture}[remember picture,overlay]
    \ifstrequal{#1}{notitle}{}{%
      \node[anchor=west,inner sep=0pt,outer sep=0pt] (backmatter-title)
        at ([xshift=\campuslogoleftskip]current page.west) {%
        \begin{minipage}{\dimexpr\campustitleboxwidth-20pt-\campustitleboxleftskip\relax}
          \raggedright\usebeamerfont{title}\usebeamercolor[fg]{normal text}%
          \inserttitle\par
        \end{minipage}%
      };
    }%
    \ifstrequal{#1}{notitle}{%
      \node[anchor=west,inner sep=0pt,outer sep=0pt] (backmatter-info)
        at ([xshift=\campuslogoleftskip]current page.west) {\campus@backmatterinfo};
    }{%
      \node[anchor=north west,inner sep=0pt,outer sep=0pt,
        yshift=0pt] (backmatter-info)
        at (backmatter-title.south west) {\campus@backmatterinfo};
    }%
      \node[anchor=south east,inner sep=0pt,outer sep=0pt,
        xshift=-\campuslogoleftskip,yshift=\campus@closingdatepadding]
      (backmatter-thanks) at (current page.east |- backmatter-info.south)
      {\usebox{\campus@closingmessage}};
    \ifcampus@layoutguides
      \ifstrequal{#1}{notitle}{}{%
        \draw[red,line width=.5pt] (backmatter-title.north west) rectangle (backmatter-title.south east);
        \node[anchor=south west,draw=red,fill=white,text=red,inner sep=1pt,font=\tiny]
          at (backmatter-title.north west)
          {\campus@guidefontlabel{title}{主标题}{\string\Huge}};
      }
      \draw[red,line width=.5pt] (backmatter-info.north west) rectangle (backmatter-info.south east);
      \node[anchor=north west,draw=red,fill=white,text=red,inner sep=1pt,font=\tiny]
        at (backmatter-info.south west)
        {\campus@guidefontlabel{subtitle}{副标题}{\string\Large}\quad
         \campus@guidefontlabel{author}{课题组/汇报人/指导教师/日期}{\string\normalsize}};
      \draw[red,line width=.5pt] (backmatter-thanks.north west) rectangle (backmatter-thanks.south east);
      \node[anchor=south east,draw=red,fill=white,text=red,inner sep=1pt,font=\tiny]
        at (backmatter-thanks.north east)
        {\campus@guidefontlabel{closing message}{致谢文字}{\string\LARGE}};
      \draw[red,dashed] ([xshift=\campuslogoleftskip]current page.north west)
        -- ([xshift=\campuslogoleftskip]current page.south west);
      \draw[red,dashed] (current page.west) -- (current page.east);
    \fi
    \end{tikzpicture}%
  \end{frame}
\endgroup
}
\makeatother

