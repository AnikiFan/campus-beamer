% ---------------------------------------------------------------
% In-page callout boxes (tip / note / alert / example / definition)
%
% Usage (optional argument overrides the default title text):
%   \begin{tipbox}[自定义标题] ... \end{tipbox}
%   \begin{alertbox}        ... \end{alertbox}
%   \begin{notebox}[Key]    ... \end{notebox}
%   \begin{examplebox}      ... \end{examplebox}
%   \begin{definitionbox}   ... \end{definitionbox}
% ---------------------------------------------------------------
\makeatletter
\RequirePackage{environ}
\RequirePackage{tcolorbox}
\RequirePackage{campuscode}
\tcbuselibrary{skins}

\tcbset{
  campus callout/.style n args={1}{
    enhanced,
    colback=#1!5!white,
    colframe=#1,
    colbacktitle=#1!10!white,
    coltitle=#1!70!black,
    boxrule=0pt,
    leftrule=3pt,
    titlerule=0pt,
    arc=0pt,
    outer arc=0pt,
    left=3mm, right=3mm,
    top=1.2mm, bottom=1.2mm,
    toptitle=0.8mm, bottomtitle=0.8mm,
    fonttitle=\bfseries\footnotesize,
    fontupper=\small,
    before skip=1.2mm, after skip=1.2mm,
  },
}

\newtcolorbox{tipbox}[1][\campus@tipboxdefault]{campus callout={tipcolor},title={#1}}
\newtcolorbox{notebox}[1][\campus@noteboxdefault]{campus callout={notecolor},title={#1}}
\newtcolorbox{alertbox}[1][\campus@alertboxdefault]{campus callout={alertcolor},title={#1}}
\newtcolorbox{examplebox}[1][\campus@exampleboxdefault]{campus callout={examplecolor},title={#1}}
\newtcolorbox{definitionbox}[1][\campus@definitionboxdefault]{campus callout={definitioncolor},title={#1}}

\setbeamertemplate{section in head/foot}{%
  \insertsectionheadnumber\enspace\insertsectionhead}
\setbeamertemplate{section in head/foot shaded}{%
  \usebeamercolor[fg]{navigation muted}\insertsectionheadnumber\enspace\insertsectionhead}
\setbeamertemplate{subsection in head/foot}{%
  \insertsectionheadnumber.\insertsubsectionheadnumber\enspace\insertsubsectionhead}
\setbeamertemplate{subsection in head/foot shaded}{%
  \usebeamercolor[fg]{navigation muted}\insertsectionheadnumber.\insertsubsectionheadnumber\enspace\insertsubsectionhead}

% One shared, page-anchored logo treatment for covers and both headline types.
% The transparent image contributes no background or layout dimensions.
\newcommand{\campus@logoblock}{%
  \begin{tikzpicture}[remember picture,overlay]
    \usebeamercolor{logo block}%
    \fill[bg] ([xshift=\campuslogoleftskip]current page.north west)
      rectangle ([xshift=\dimexpr\campuslogoleftskip+\campuslogowidth\relax,
        yshift=-\campuslogoheight]current page.north west);
    \node[anchor=south,inner sep=0pt,outer sep=0pt]
      at ([xshift=\dimexpr\campuslogoleftskip+.5\campuslogowidth\relax,
        yshift=\dimexpr-\campuslogoheight+\campuslogopadding\relax]current page.north west)
      {\pgfuseimage{\@logo}};
  \end{tikzpicture}%
}
% Put the logo in each slide's top left area.
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=\campusheadlineheight,dp=0pt,leftskip=\campuslogoleftskip]{headline}
    \campus@logoblock
  \end{beamercolorbox}
}

% Single-line header bottoms sit one tiny baseline above the logo block bottom.
% The inset uses the same measured tiny baseline as the empty header grid row.
% Reserve the
% same header height as two-line frames so the body stays below the logo strip.
\newcommand{\campus@singleheader}{%
  \vspace*{-\campusheadlineheight}%
  \begin{beamercolorbox}[wd=\paperwidth,ht=\campuslogoheight,dp=0pt,vmode]{frametitle}%
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=south west,inner sep=0pt,outer sep=0pt]
        at ([xshift=\dimexpr\campuslogoleftskip+\campusframetitleleftskip\relax,
          yshift=\dimexpr-\campuslogoheight+\campusheaderemptybaseline\relax]current page.north west)
        {\usebeamerfont{single frame title}\insertframetitle};
    \end{tikzpicture}%
  \end{beamercolorbox}%
}

% The upper header line shows the subsection; the lower line shows the frame
% title in normalsize. The header is a three-row grid: the empty top row uses one
% tiny baseline, the title-style row uses one frametitle baseline, and the
% subtitle-style row uses one framesubtitle baseline.
\setbeamertemplate{frametitle}{%
  \ifx\insertframesubtitle\@empty
    \campus@singleheader
  \else
  % The headline occupies the logo strip; the three-row header grid itself
  % starts at the physical top edge so the empty first row is exactly one
  % baseline rather than headline height plus one baseline.
  \vspace*{-\campusheadlineheight}%
  \begin{beamercolorbox}[
      wd=\paperwidth,
      ht=\dimexpr\campusheaderemptybaseline+\campusheaderbaseline+\campusheadersubtitlebaseline\relax,
      dp=0pt,
      leftskip=0pt,
      vmode
    ]{frametitle}%
    \offinterlineskip
    \hspace*{\dimexpr\campuslogoleftskip+\campusframetitleleftskip\relax}%
    \vbox to \dimexpr\campusheaderemptybaseline+\campusheaderbaseline+\campusheadersubtitlebaseline\relax{%
      \vbox to \campusheaderemptybaseline{\vfil}%
      \vbox to \campusheaderbaseline{%
        \vfil
        \hbox{\usebeamerfont{frametitle}\insertframesubtitle}%
        \vfil
      }%
      \vbox to \campusheadersubtitlebaseline{%
        \vfil
          \hbox{\usebeamerfont{framesubtitle}\insertframetitle}%
        \vfil
      }%
    }%
  \end{beamercolorbox}
  \fi
}

% Generated overview pages always use the single-line header, including
% references continuations and pages created while a subsection is active.
\defbeamertemplate{frametitle}{campus page title}{%
  \campus@singleheader
}

