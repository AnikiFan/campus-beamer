\newcommand{\campus@guidefontlabel}[3]{%
  \begingroup
    \usebeamerfont{#1}%
    \edef\campus@guidefontsize{\f@size}%
    \edef\campus@guidebaselineskip{\the\baselineskip}%
    \scriptsize\texttt{#3} (\campus@guidefontsize pt);\space
    \texttt{\string\baselineskip}=\campus@guidebaselineskip
  \endgroup
}
% Measure vertical whitespace between anchors in the indicated font's grid.
\newcommand{\campus@guideverticalgap}[5]{%
  \draw[red,<->] (#1) -- (#2)
    node[midway,right,fill=white,text=red,font=\tiny,inner sep=.5pt] {%
      #5:\space
      \begingroup
        \pgfextracty{\dimen0}{\pgfpointdiff
          {\pgfpointanchor{#1}{center}}{\pgfpointanchor{#2}{center}}}%
        \pgfmathparse{abs(\the\dimen0)/(\the#3)}%
        \pgfmathprintnumber[fixed,precision=2]{\pgfmathresult}%
      \endgroup
      \space\texttt{baselineskip} (#4)};
}
