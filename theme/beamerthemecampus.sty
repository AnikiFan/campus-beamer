% Set colours
% NOTE! Beamer colors should be set in the preamble. It often works fine in the
%       document itself, but NOT for normal text foreground.
%       \themecolor should only be called from the preamble.
\newcommand{\themecolor}[1]{
    % The footer always follows the school profile's main color.
    \setbeamercolor{footline}{fg=white,bg=maincolor}
	\ifstrequal{#1}{main}{%
		\setbeamercolor{headline}{fg=white,bg=maincolor}
        \setbeamercolor{logo block}{bg=white}
		\setbeamercolor{navigation muted}{fg=white!65!maincolor}
		\setbeamercolor{navigation footer}{fg=white,bg=maincolor}
		\setbeamercolor{navigation footer section}{fg=white,bg=maincolor}
		\setbeamercolor{navigation footer subsection}{fg=white,bg=maincolor!72!white}
		\setbeamercolor{section in head/foot}{fg=white,bg=}
		\setbeamercolor{subsection in head/foot}{fg=white,bg=}
		\setbeamercolor{normal text}{fg=white,bg=maincolor}
		\setbeamercolor{structure}{fg=white}
		\renewcommand{\@logo}{whitelogo}
	}{%
		\setbeamercolor{headline}{fg=darkgray,bg=white}
        \setbeamercolor{logo block}{bg=maincolor}
		\setbeamercolor{navigation muted}{fg=black!55}
		\setbeamercolor{navigation footer}{fg=maincolor,bg=white}
		\setbeamercolor{navigation footer section}{fg=maincolor,bg=maincolor!18!white}
		\setbeamercolor{navigation footer subsection}{fg=maincolor,bg=maincolor!7!white}
		\setbeamercolor{section in head/foot}{fg=maincolor,bg=}
		\setbeamercolor{subsection in head/foot}{fg=maincolor,bg=}
		\setbeamercolor{normal text}{fg=darkgray,bg=white}
		\setbeamercolor{structure}{fg=maincolor}
		\renewcommand{\@logo}{logo}
	}
}
