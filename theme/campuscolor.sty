\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{campuscolor}[2026/10/12 School profile loader]
\RequirePackage{xcolor}
\RequirePackage{kvoptions}
\RequirePackage{etoolbox}
\SetupKeyvalOptions{family=campusprofile,prefix=campusprofile@}
\DeclareStringOption[general]{theme}
\ProcessKeyvalOptions*

% Select a directory name, never a path or a TeX input expression.
\ExplSyntaxOn
\exp_args:NnV \regex_match:nnTF { \A [a-zA-Z0-9] [a-zA-Z0-9_-]* \Z } \campusprofile@theme
  { }
  { \PackageError{campuscolor}{Invalid~theme~name}
      {Use~a~directory~name~containing~letters,~digits,~hyphens~or~underscores.} }
\ExplSyntaxOff
\edef\campusthemedir{theme/\campusprofile@theme}
\InputIfFileExists{\campusthemedir/profile.tex}{}{%
  \PackageError{campuscolor}{Unknown theme '\campusprofile@theme'}%
    {Create \campusthemedir/profile.tex or select an installed theme.}}

\newcommand{\campusprofile@checkcolor}[1]{%
  \@ifundefinedcolor{#1}{%
    \PackageError{campuscolor}{Theme '\campusprofile@theme' is missing color '#1'}%
      {Define all six functional colors in \campusthemedir/profile.tex.}}{}}
\forcsvlist{\campusprofile@checkcolor}{maincolor,tipcolor,notecolor,alertcolor,examplecolor,definitioncolor}
\newcommand{\campusprofile@checkcommand}[1]{%
  \ifcsdef{#1}{}{%
    \PackageError{campuscolor}{Theme '\campusprofile@theme' is missing '#1'}%
      {Define all four emblem and wordmark paths in \campusthemedir/profile.tex.}}}
\forcsvlist{\campusprofile@checkcommand}{schoolemblemondark,schoolemblemonlight,schoolwordmarkondark,schoolwordmarkonlight}
\endinput
