\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{campuscolor}[2026/10/02 Institution-independent theme colors]
\RequirePackage{xcolor}
% School identity and functional colors. Talk images belong in the talk source.
% Default profile: Tsinghua University. Keep layout in beamerthemecampus.sty.
% Loaded automatically by the campus theme after xcolor; do not load it twice.
% Presentation metadata belongs in sections/metadata.tex, not this profile.

% Main theme color: cover panels, section pages, headings, navigation and footer.
% The footer uses this color automatically; it has no separate color option.
\definecolor{maincolor}{RGB/cmyk}{85,33,116/27,72,0,55}

% Callout colors: name the role, not the hue. The theme derives each box's
% background, title shade and border from its role color.
\definecolor{tipcolor}{HTML}{22A7E5}
\colorlet{notecolor}{maincolor} % Follows the main color unless set independently.
\definecolor{alertcolor}{HTML}{EC008C}
\definecolor{examplecolor}{RGB/cmyk}{20,185,120/.73,0,.67,0}
\definecolor{definitioncolor}{HTML}{B36B16} % Distinct from the purple note color.

% Transparent emblems: white artwork for dark blocks, colored artwork for light blocks.
% Paths may include extensions. Supply your own local artwork in assets/.
\newcommand{\schoolemblemondark}{assets/emblem_on_dark}
\newcommand{\schoolemblemonlight}{assets/emblem_on_light}
% Transparent university wordmarks: white artwork for dark grounds, colored for light grounds.
\newcommand{\schoolwordmarkondark}{assets/wordmark_on_dark}
\newcommand{\schoolwordmarkonlight}{assets/wordmark_on_light}
